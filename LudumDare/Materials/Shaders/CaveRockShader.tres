[gd_resource type="Shader" format=3 uid="uid://b2x56jxklr1lv"]

[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec4 albedo : source_color;

uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D texture_normal : hint_roughness_normal, filter_linear_mipmap, repeat_enable;
uniform sampler2D texture_roughness : hint_roughness_r, filter_linear_mipmap, repeat_enable;
uniform sampler2D texture_ambient_occlusion : hint_default_white, filter_linear_mipmap, repeat_enable;

// Second texture set
uniform sampler2D texture_albedo_2 : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D texture_normal_2 : hint_roughness_normal, filter_linear_mipmap, repeat_enable;
uniform sampler2D texture_roughness_2 : hint_roughness_r, filter_linear_mipmap, repeat_enable;
uniform sampler2D texture_ambient_occlusion_2 : hint_default_white, filter_linear_mipmap, repeat_enable;

// Blend mask
uniform sampler2D texture_noise : filter_linear_mipmap, repeat_enable;
uniform float blend_threshold : hint_range(0.0, 1.0) = 0.5;
uniform float blend_softness : hint_range(0.001, 0.5) = 0.1;

uniform float roughness : hint_range(0.0, 1.0);
uniform float specular : hint_range(0.0, 1.0, 0.01);
uniform float metallic : hint_range(0.0, 1.0, 0.01);
uniform float normal_scale : hint_range(-16.0, 16.0);

uniform sampler2D texture_metallic : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform vec4 metallic_texture_channel;

uniform vec4 ao_texture_channel;
uniform float ao_light_affect : hint_range(0.0, 1.0, 0.01);

varying vec3 uv1_triplanar_pos;
varying vec3 uv1_power_normal;

uniform float uv1_blend_sharpness : hint_range(0.0, 150.0, 0.001);

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;

void vertex() {
	vec3 normal = MODEL_NORMAL_MATRIX * NORMAL;

	TANGENT = vec3(0.0, 0.0, -1.0) * abs(normal.x);
	TANGENT += vec3(1.0, 0.0, 0.0) * abs(normal.y);
	TANGENT += vec3(1.0, 0.0, 0.0) * abs(normal.z);
	TANGENT = inverse(MODEL_NORMAL_MATRIX) * normalize(TANGENT);

	BINORMAL = vec3(0.0, 1.0, 0.0) * abs(normal.x);
	BINORMAL += vec3(0.0, 0.0, -1.0) * abs(normal.y);
	BINORMAL += vec3(0.0, 1.0, 0.0) * abs(normal.z);
	BINORMAL = inverse(MODEL_NORMAL_MATRIX) * normalize(BINORMAL);

	uv1_power_normal = pow(abs(normal), vec3(uv1_blend_sharpness));

	uv1_triplanar_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz * uv1_scale + uv1_offset;

	uv1_power_normal /= dot(uv1_power_normal, vec3(1.0));
	uv1_triplanar_pos *= vec3(1.0, -1.0, 1.0);
}

vec4 triplanar_texture(sampler2D p_sampler, vec3 p_weights, vec3 p_triplanar_pos) {
	vec4 samp = vec4(0.0);

	samp += texture(p_sampler, p_triplanar_pos.xy) * p_weights.z;
	samp += texture(p_sampler, p_triplanar_pos.xz) * p_weights.y;
	samp += texture(p_sampler, p_triplanar_pos.zy * vec2(-1.0, 1.0)) * p_weights.x;

	return samp;
}

void fragment() {
	// Blend mask
	float noise = triplanar_texture(texture_noise, uv1_power_normal, uv1_triplanar_pos).r;
	float mask = smoothstep(blend_threshold - blend_softness, blend_threshold + blend_softness, noise);

	// Albedo
	vec4 albedo1 = triplanar_texture(texture_albedo, uv1_power_normal, uv1_triplanar_pos);
	vec4 albedo2 = triplanar_texture(texture_albedo_2, uv1_power_normal, uv1_triplanar_pos);

	vec3 blended_albedo = mix(albedo2.rgb, albedo1.rgb, mask);

	ALBEDO = albedo.rgb * blended_albedo;

	// Metallic
	float metallic_tex = dot( triplanar_texture(texture_metallic, uv1_power_normal, uv1_triplanar_pos), metallic_texture_channel);

	METALLIC = metallic_tex * metallic;
	SPECULAR = specular;

	// Roughness
	vec4 roughness_texture_channel = vec4(1.0, 0.0, 0.0, 0.0);
	float roughness1 = dot(triplanar_texture(texture_roughness, uv1_power_normal, uv1_triplanar_pos), roughness_texture_channel);
	float roughness2 = dot(triplanar_texture(texture_roughness_2, uv1_power_normal, uv1_triplanar_pos ), roughness_texture_channel);

	ROUGHNESS = mix(roughness2, roughness1, mask) * roughness;

	// Normal
	vec3 normal1 = triplanar_texture(texture_normal, uv1_power_normal, uv1_triplanar_pos).rgb;
	vec3 normal2 = triplanar_texture(texture_normal_2, uv1_power_normal, uv1_triplanar_pos).rgb;

	NORMAL_MAP = normalize(mix(normal2, normal1, mask));
	NORMAL_MAP_DEPTH = normal_scale;

	// Ambient Occlusion
	float ao1 = dot(triplanar_texture(texture_ambient_occlusion, uv1_power_normal, uv1_triplanar_pos), ao_texture_channel);
	float ao2 = dot(triplanar_texture(texture_ambient_occlusion_2, uv1_power_normal, uv1_triplanar_pos), ao_texture_channel);

	AO = mix(ao2, ao1, mask);
	AO_LIGHT_AFFECT = ao_light_affect;
}"
